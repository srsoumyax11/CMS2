# ==============================================================================
# Campus Management System - Production Environment Variables Configuration
# ==============================================================================

# Node Environment (development | staging | production | test)
NODE_ENV=production

# Application HTTP Server Listening Port
PORT=3000

# PostgreSQL Database Connection String (Prisma format)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=<schema>&connection_limit=<limit>&idle_timeout=<seconds>
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/campus_db?schema=campus&connection_limit=15&idle_timeout=30

# JWT Access Token Signing Secret (Must be at least 16 characters long)
JWT_SECRET=super_secret_jwt_key_campus7_production_hardening_2026

# JWT Refresh Token Signing Secret (Must be at least 16 characters long)
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_campus7_production_hardening_2026

# JWT Token Expiration Durations
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Cache & Rate Limiter Connection URL
REDIS_URL=redis://localhost:6379

# Allowed Cross-Origin Resource Sharing (CORS) Origins (Comma-separated list, e.g. http://localhost:8081,http://localhost:3000)
CORS_ORIGIN=*
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Interactive Swagger Documentation Toggle (true | false) - Default false in production
ENABLE_SWAGGER=false

# Developer Raw Internal Error Exposure Flag (true | false) - Forced to false in production
EXPOSE_RAW_ERRORS=false

# Web Refresh Token Cookie Security Settings
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=campus.edu

# System Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# File Upload Maximum Allowed Payload Size in Bytes (10485760 = 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Rate Limiter Bypass Flags (true | false)
SKIP_RATE_LIMIT=false
ENABLE_TEST_RATE_LIMIT=false
