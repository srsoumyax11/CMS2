# Campus Management System - Environment Variables Configuration

# Node Environment (development | staging | production)
NODE_ENV=production

# Server Port
PORT=3000

# PostgreSQL Database Connection String (Prisma format)
# Note: Ensure schema=campus is specified for schema isolation
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/campus_db?schema=campus&connection_limit=15&idle_timeout=30

# JWT Authentication Secrets (Must be at least 32 characters long in production)
JWT_SECRET=super_secret_production_jwt_access_token_key_32_chars
JWT_REFRESH_SECRET=super_secret_production_jwt_refresh_token_key_32_chars

# Redis Cache & Rate Limiter URL
REDIS_URL=redis://localhost:6379

# Allowed CORS Origins (Comma-separated origins or * for open CORS)
CORS_ORIGIN=*

# Log Level (debug | info | warn | error)
LOG_LEVEL=info

# File Upload Settings (Max size in bytes: 10485760 = 10MB)
MAX_FILE_SIZE_BYTES=10485760
