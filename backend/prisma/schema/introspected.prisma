  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asset_damage_reports {
  id                                                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id                                          String   @db.Uuid
  reported_by                                       String   @db.Uuid
  description                                       String
  photo_file_id                                     String?  @db.Uuid
  charged_user_id                                   String?  @db.Uuid
  charge_amount                                     Decimal? @db.Decimal(12, 2)
  status                                            String   @default("open")
  created_at                                        DateTime @default(now()) @db.Timestamptz(6)
  assets                                            assets   @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_asset_damage_reports_charged_user_idTousers users?   @relation("asset_damage_reports_charged_user_idTousers", fields: [charged_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files                                             files?   @relation(fields: [photo_file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_asset_damage_reports_reported_byTousers     users    @relation("asset_damage_reports_reported_byTousers", fields: [reported_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([asset_id])
  @@index([charged_user_id])
  @@index([photo_file_id])
  @@index([reported_by])
  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assets {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_tag            String                 @unique
  category_id          String                 @db.Uuid
  name                 String
  serial_no            String?
  purchased_on         DateTime?              @db.Date
  purchase_cost        Decimal?               @db.Decimal(12, 2)
  vendor_id            String?                @db.Uuid
  status               String                 @default("in_use")
  item_condition       String                 @default("good")
  location_id          String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  asset_assignments    asset_assignments[]
  asset_damage_reports asset_damage_reports[]
  asset_categories     asset_categories       @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations            locations?             @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors              vendors?               @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets              tickets[]

  @@index([category_id])
  @@index([location_id])
  @@index([vendor_id])
  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assignment_submissions {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignment_id      String      @db.Uuid
  student_id         String      @db.Uuid
  file_id            String      @db.Uuid
  submitted_at       DateTime    @default(now()) @db.Timestamptz(6)
  similarity_percent Decimal?    @db.Decimal(5, 2)
  marks              Decimal?    @db.Decimal(6, 2)
