generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["campus", "public"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model academic_years {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label                  String                   @unique
  start_date             DateTime                 @db.Date
  end_date               DateTime                 @db.Date
  is_current             Boolean                  @default(false)
  admission_applications admission_applications[]
  batches                batches[]
  fee_structures         fee_structures[]
  invoices               invoices[]
  terms                  terms[]

  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model addresses {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  kind       String
  line1      String
  line2      String?
  pin_code   String    @db.Char(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  pin_codes  pin_codes @relation(fields: [pin_code], references: [pin_code], onDelete: NoAction, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pin_code])
  @@index([user_id])
  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admission_applications {
  id                                                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicant_user_id                                     String                  @db.Uuid
  course_id                                             String                  @db.Uuid
  academic_year_id                                      String                  @db.Uuid
  status                                                String                  @default("draft")
  submitted_at                                          DateTime?               @db.Timestamptz(6)
  decided_by                                            String?                 @db.Uuid
  decided_at                                            DateTime?               @db.Timestamptz(6)
  created_at                                            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                                            DateTime                @default(now()) @db.Timestamptz(6)
  deleted_at                                            DateTime?               @db.Timestamptz(6)
  academic_years                                        academic_years          @relation(fields: [academic_year_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_admission_applications_applicant_user_idTousers users                   @relation("admission_applications_applicant_user_idTousers", fields: [applicant_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courses                                               courses                 @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_admission_applications_decided_byTousers        users?                  @relation("admission_applications_decided_byTousers", fields: [decided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application_documents                                 application_documents[]

  @@unique([applicant_user_id, course_id, academic_year_id])
  @@index([academic_year_id])
  @@index([course_id])
  @@index([decided_by])
  @@schema("campus")
}

model alumni_profiles {
  user_id          String   @id @db.Uuid
  graduation_year  Int      @db.SmallInt
  current_employer String?
  current_title    String?
  is_public        Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model anonymous_reports {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash      String            @unique
  category        String
  body            String
  location_id     String?           @db.Uuid
  status          String            @default("new")
  assigned_to     String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  users           users?            @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations       locations?        @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  case_access_log case_access_log[]
  safety_cases    safety_cases[]

  @@index([assigned_to])
  @@index([location_id])
  @@schema("campus")
}

model app_config {
  config_key String   @id
  value      String
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("campus")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_documents {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id         String                 @db.Uuid
  doc_kind               String
  file_id                String                 @db.Uuid
  status                 String                 @default("uploaded")
  verified_by            String?                @db.Uuid
  verified_at            DateTime?              @db.Timestamptz(6)
  reject_reason          String?
  admission_applications admission_applications @relation(fields: [application_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files                  files                  @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?                 @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([application_id, doc_kind])
  @@index([file_id])
  @@index([verified_by])
  @@schema("campus")
}

model asset_assignments {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id                                 String    @db.Uuid
  user_id                                  String    @db.Uuid
  issued_by                                String    @db.Uuid
  issued_at                                DateTime  @default(now()) @db.Timestamptz(6)
  returned_at                              DateTime? @db.Timestamptz(6)
  assets                                   assets    @relation(fields: [asset_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_asset_assignments_issued_byTousers users     @relation("asset_assignments_issued_byTousers", fields: [issued_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_asset_assignments_user_idTousers   users     @relation("asset_assignments_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([issued_by])
  @@index([user_id])
  @@schema("campus")
}

model asset_categories {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String   @unique
