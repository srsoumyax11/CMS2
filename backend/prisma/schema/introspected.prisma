  graded_at          DateTime?   @db.Timestamptz(6)
  assignments        assignments @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files              files       @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff              staff?      @relation(fields: [graded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  students           students    @relation(fields: [student_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assignment_id, student_id])
  @@index([file_id])
  @@index([graded_by])
  @@index([student_id])
  @@schema("campus")
}

