{
  "name": "@campus/api-client",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "contract:generate": "openapi-typescript openapi/spec.json -o openapi/schema.d.ts",
    "contract:check": "tsx scripts/contract-check.ts",
    "api:sync": "tsx scripts/sync-api-spec.ts"
  },
  "dependencies": {
    "@campus/config": "workspace:*",
    "@campus/logger": "workspace:*",
    "@tanstack/react-query": "^5.51.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
